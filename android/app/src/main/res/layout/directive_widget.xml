<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widgetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DIRECTIVE / ACTIVE"
        android:textColor="#1C7BA6"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetRecipient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:text="[사용자에게]"
        android:textColor="#5CD0FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetTrigger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:text="지금,"
        android:textColor="#3188B5"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widgetAction"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:text="현재 지령을 확인하세요."
        android:textColor="#8EDFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
